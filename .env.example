# Clés IA-S3 (https://archive.org/account/s3.php)
# Copier ce fichier en .env et renseigner les valeurs. .env est ignoré par Git.
INTERNET_ARCHIVE_S3_ACCESS_key=
INTERNET_ARCHIVE_S3_SECRET_KEY=

# Optionnel : identifiant de l'item Internet Archive
# CANDIDAT_ARCHIVE_ITEM=candidats-2027-exports

# Optionnel : dossier local des exports
# CANDIDAT_EXPORTS=C:\Users\admin\Music\exports ableton\Candid_2027_ats
